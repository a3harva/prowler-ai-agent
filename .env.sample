# Copy to .env.local and replace every value marked CHANGE_ME.
# Never commit .env.local or use real infrastructure identifiers in examples.

APP_ENV=local
POSTGRES_USER=appuser
POSTGRES_DB=prowler_agent
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg2://appuser:CHANGE_ME_GENERATE_A_RANDOM_PASSWORD@postgres:5432/prowler_agent
TEST_DATABASE_URL=postgresql+psycopg2://appuser:CHANGE_ME_GENERATE_A_RANDOM_PASSWORD@postgres:5432/prowler_agent_test
REDIS_URL=redis://redis:6379/0
DOCKER_HOST=unix:///var/run/docker.sock
PROWLER_IMAGE=toniblyx/prowler:5.39.0
REPORTS_PATH=/reports
HOST_REPORTS_PATH=/absolute/path/to/your/checkout/reports
MAX_CONCURRENT_SCANS=1
SCAN_TIMEOUT_SECONDS=1800
# Path to a dedicated, least-privilege ADC JSON file for local containers.
# Never point this at an entire gcloud configuration directory.
GCLOUD_ADC_PATH=/absolute/path/to/dedicated-adc.json

# Authentication. Leave OAuth values empty to disable Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_ORIGIN=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1
# Enable the interactive API docs in a non-local environment. Disabled by
# default; local development always exposes them.
ENABLE_API_DOCS=false
JWT_SIGNING_KEY=CHANGE_ME_GENERATE_A_32_BYTE_RANDOM_SECRET
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ALLOWED_EMAIL_DOMAIN=example.test
BOOTSTRAP_ADMIN_EMAILS=admin@example.test

# Optional support-system integration.
FRESHSERVICE_DOMAIN=
FRESHSERVICE_API_KEY=

# Optional Google Cloud and AI integrations.
GCP_PROJECT_ID=
GEMINI_PROJECT_ID=
GEMINI_SERVICE_ACCOUNT=
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_AGENT_MODEL=gemini-2.5-flash
GEMINI_AGENT_MAX_OUTPUT_TOKENS=4096

# Optional tracing. Leave both keys empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000

# Optional live cloud-context worker.
CLOUD_CLI_IMAGE=google/cloud-sdk:slim
CLOUD_CLI_ENABLED=false
MAX_CONCURRENT_CLI_SESSIONS=1
MAX_CONCURRENT_REPORTS=1
VITE_API_BASE_URL=/api
